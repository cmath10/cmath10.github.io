# Timeline geometry baseline.
# Use with:
# make geom PLAYWRIGHT_GEOM_SCENARIO_FILE=recipes/geom/timeline.env

PLAYWRIGHT_GEOM_URL=/
PLAYWRIGHT_GEOM_FILE=/artifacts/geom/timeline-geometry.json
PLAYWRIGHT_GEOM_OVERLAY_FILE=/artifacts/geom/timeline-geometry-overlay.png
PLAYWRIGHT_GEOM_SELECTORS='.timeline-marker,.timeline-segment-before,.timeline-segment-after,.site-timeline-entry-title,.site-timeline-skill-row'
PLAYWRIGHT_GEOM_RELATIONS='marker_to_title|.timeline-marker|center-y|.site-timeline-entry-title|center-y|0;marker_to_after|.timeline-marker|center-y|.timeline-segment-after|top|0;after_to_next_before|.timeline-segment-after|bottom|.timeline-segment-before|top|0;before_to_marker|.timeline-segment-before|bottom|.timeline-marker|center-y|1;skills_to_next_title|.site-timeline-skill-row|bottom|.site-timeline-entry-title|top|1'
