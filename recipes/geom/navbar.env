# Navbar spans two 30px grid cells; its logo is vertically centered.
# Use with: make geom PLAYWRIGHT_GEOM_SCENARIO_FILE=recipes/geom/navbar.env

PLAYWRIGHT_GEOM_URL=/
PLAYWRIGHT_GEOM_FILE=${PLAYWRIGHT_GEOM_FILE:-artifacts/playwright/geom/navbar-geometry.json}
PLAYWRIGHT_GEOM_OVERLAY_FILE=${PLAYWRIGHT_GEOM_OVERLAY_FILE:-artifacts/playwright/geom/navbar-geometry-overlay.png}
PLAYWRIGHT_GEOM_SELECTORS='.VPNavBar,.VPNavBar .logo,.site-band-hero'
PLAYWRIGHT_GEOM_RELATIONS='navbar_height|.VPNavBar|top|.VPNavBar|bottom|0;navbar_to_hero|.VPNavBar|bottom|.site-band-hero|top|0;logo_center|.VPNavBar|center-y|.VPNavBar .logo|center-y|0'
